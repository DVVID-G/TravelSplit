# Production Dockerfile for Render (or any Docker host).
# Build: docker build -f Dockerfile.production -t travelsplit-backend .
# Expects: DB_* and JWT_SECRET etc. at runtime.

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY nest-cli.json tsconfig.json tsconfig.build.json data-source.ts ./
RUN npm ci

COPY scripts ./scripts
RUN sed -i 's/\r$//' scripts/docker-entrypoint-production.sh && chmod +x scripts/docker-entrypoint-production.sh

COPY src ./src

RUN npm run build

EXPOSE 3000

ENTRYPOINT ["/bin/sh", "./scripts/docker-entrypoint-production.sh"]
